# DeepSeek cloud report provider.
# Do not commit a filled .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=8000

# Public prototype protection and resource limits.
APP_REQUIRE_ACCESS=true
APP_ACCESS_CODE=请设置至少12位随机口令
APP_ENFORCE_USAGE_LIMITS=true

